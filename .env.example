NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
# Protects /api/cron/* — set the same value in Vercel project env as CRON_SECRET
CRON_SECRET=
DATABASE_URL=
REDIS_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OBJECT_STORAGE_BUCKET=
EMAIL_PROVIDER_API_KEY=

# PX demand provider (server-side only — never expose to clients)
PX_API_TOKEN=
PX_BASE_URL=https://leadapi.px.com

# Safety: simulated delivery is blocked in production automatically.
# Set to 0 to also disable simulation in development/test.
# QENTRAX_ALLOW_SIMULATED_DELIVERY=0
# QENTRAX_FORCE_PRODUCTION=1

