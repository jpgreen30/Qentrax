# Qentrax MCP Phase 1.5 OAuth — never commit real values

# Public HTTPS origin of this MCP service (Render URL)
MCP_PUBLIC_URL=https://qentrax-mcp.onrender.com

# HMAC secret for access/refresh JWTs (≥16 chars)
MCP_JWT_SECRET=replace-with-long-random-secret

# Optional bridge secret shared with Qentrax Next.js for membership-aware API calls
QENTRAX_MCP_BRIDGE_SECRET=replace-with-long-random-secret

# Supabase (used for OAuth login + membership reads)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# or SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Qentrax app API base (capability routes)
QENTRAX_API_BASE_URL=https://your-qentrax-app.vercel.app

# Listen (Render sets PORT)
PORT=3100
MCP_HOST=0.0.0.0

# Token TTLs (seconds)
MCP_ACCESS_TOKEN_TTL=3600
MCP_REFRESH_TOKEN_TTL=2592000
