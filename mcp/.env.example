# Qentrax MCP Phase 1 — never commit real values

# Token ChatGPT / clients send as Authorization: Bearer ...
QENTRAX_MCP_TOKEN=replace-with-long-random-secret

# Org bound to this MCP token (performance always uses this; model cannot override)
QENTRAX_MCP_ORG_ID=00000000-0000-0000-0000-000000000000
QENTRAX_MCP_ROLE=publisher
QENTRAX_MCP_LABEL=Qentrax MCP prototype

# Base URL of the Qentrax Next.js app (capability APIs)
QENTRAX_API_BASE_URL=http://127.0.0.1:3000

# MCP HTTP listen
MCP_PORT=3100
MCP_HOST=0.0.0.0
